<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Participant registrations | LocalEvents</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"><link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header"><nav class="site-nav" aria-label="Main navigation"><a class="wordmark" href="/"><span class="wordmark__icon"><i class="fa-regular fa-calendar-days" aria-hidden="true"></i></span>LocalEvents</a><div class="site-nav__links"><a class="nav-link" href="/admin/">Organizer dashboard</a><a class="nav-link" href="/">Event discovery</a></div></nav></header>
  <main class="page-container page-section">
    <div class="list-header"><div><p class="page-kicker">Organizer workspace</p><h1 class="page-title">Participant registrations</h1><p class="page-subtitle">A complete view of the people registered for your published events.</p></div><div class="count-total" aria-label="<%= count %> total registrations"><strong><%= count %></strong><span>Total</span></div></div>
    <% if (register && register.length > 0) { %>
      <section class="records-panel" aria-label="Participant records"><table class="records-table"><thead><tr><th scope="col">Event</th><th scope="col">Participant</th><th scope="col">Phone</th><th scope="col">Email</th></tr></thead><tbody><% register.forEach(registration => { const event = registration.eventId; const eventDate = event && event.eventDate ? new Date(event.eventDate) : null; const validDate = eventDate && !Number.isNaN(eventDate.getTime()); %><tr><td class="records-table__event"><%= event?.Title || 'Event no longer available' %><span class="records-table__sub"><i class="fa-regular fa-calendar" aria-hidden="true"></i> <%= validDate ? eventDate.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date unavailable' %></span></td><td><%= registration.fullName %></td><td><%= registration.phone %></td><td><%= registration.email %></td></tr><% }) %></tbody></table>
        <div class="participant-cards"><% register.forEach(registration => { const event = registration.eventId; const eventDate = event && event.eventDate ? new Date(event.eventDate) : null; const validDate = eventDate && !Number.isNaN(eventDate.getTime()); %><article class="participant-card"><h2><%= registration.fullName %></h2><p><strong><%= event?.Title || 'Event no longer available' %></strong> · <%= validDate ? eventDate.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date unavailable' %></p><p><%= registration.email %> · <%= registration.phone %></p></article><% }) %></div>
      </section>
    <% } else { %><section class="empty-state"><i class="fa-solid fa-people-group" aria-hidden="true"></i><h2>No participant registrations yet</h2><p>Registrations will appear here as attendees join your events.</p></section><% } %>
  </main>
  <footer class="site-footer">&copy; 2026 LocalEvents &middot; Discover, connect, and take part.</footer>
</body>
</html>
