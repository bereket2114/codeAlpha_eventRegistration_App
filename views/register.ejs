<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Create account | LocalEvents</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/auth.css">
</head>
<body class="auth-page">
  <header class="auth-header"><a class="wordmark" href="/"><span class="wordmark__icon"><i class="fa-regular fa-calendar-days" aria-hidden="true"></i></span>LocalEvents</a><p>Already have an account? <a href="/register/login">Sign in</a></p></header>
  <main class="auth-main"><section class="auth-card" aria-labelledby="create-account-title"><span class="wordmark__icon"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></span><p class="page-kicker">Create your account</p><h1 id="create-account-title">Join your local scene.</h1><p class="intro">Create an account to discover events and keep your plans in one place.</p>
    <% if (locals.messages && locals.messages.errors) { %><% messages.errors.forEach(message => { %><div class="alert" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><p><%= message.msg %></p></div><% }) %><% } %>
    <form action="/register/signup" method="POST" class="form-grid"><div class="form-field"><label for="userName">Username</label><input id="userName" type="text" name="userName" placeholder="Choose a username" autocomplete="username" required></div><div class="form-field"><label for="email">Email address</label><input id="email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required></div><div class="form-field"><label for="password">Password</label><input id="password" type="password" name="password" placeholder="At least 8 characters" autocomplete="new-password" minlength="8" required></div><div class="form-field"><label for="confirmPassword">Confirm password</label><input id="confirmPassword" type="password" name="confirmPassword" placeholder="Repeat your password" autocomplete="new-password" minlength="8" required></div><button type="submit" class="button button--primary button--wide">Create account <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></form>
    <p class="mobile-switch">Already have an account? <a href="/register/login">Sign in</a></p></section></main>
  <footer class="site-footer auth-footer">&copy; 2026 LocalEvents</footer>
</body>
</html>
