<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>My Events | LocalEvents</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"><link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header"><nav class="site-nav" aria-label="Main navigation"><a class="wordmark" href="/"><span class="wordmark__icon"><i class="fa-regular fa-calendar-days" aria-hidden="true"></i></span>LocalEvents</a><div class="site-nav__links"><a class="nav-link" href="/">All events</a><a class="nav-link" href="/register/logout">Sign out</a></div></nav></header>
  <main class="page-container page-section page-section--narrow">
    <div class="list-header"><div><p class="page-kicker">Your calendar</p><h1 class="page-title">My events</h1><p class="page-subtitle">Review your upcoming registrations or release a place you no longer need.</p></div></div>
    <% if (myEvent && myEvent.length > 0) { %>
      <div class="registration-list" aria-label="Your registered events">
        <% myEvent.forEach(registration => { const event = registration.eventId; const eventDate = event && event.eventDate ? new Date(event.eventDate) : null; const validDate = eventDate && !Number.isNaN(eventDate.getTime()); %>
          <article class="registration-row">
            <div><h2 class="registration-row__title"><%= event?.Title || 'Event no longer available' %></h2><div class="registration-row__meta"><span><i class="fa-regular fa-calendar-days" aria-hidden="true"></i><%= validDate ? eventDate.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date unavailable' %></span><% if (event) { %><span><i class="fa-solid fa-users" aria-hidden="true"></i><%= event.Capacity %> spaces currently available</span><% } %></div></div>
            <form action="/register/cancel/<%= registration._id %>?_method=DELETE" method="POST"><button class="button button--danger" type="submit">Cancel registration</button></form>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state"><i class="fa-regular fa-calendar" aria-hidden="true"></i><h2>No registrations yet</h2><p>When you register for an event, it will appear here.</p><a class="button button--primary" href="/">Browse events</a></div>
    <% } %>
  </main>
  <footer class="site-footer">&copy; 2026 LocalEvents &middot; Discover, connect, and take part.</footer>
</body>
</html>
